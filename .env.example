# Optional defaults for the Arete Electron starter.
# Copy to `.env` (never commit `.env`). These pre-fill the Connect form; you can
# still change them in the app UI at runtime. The password is intentionally NOT
# stored in code — enter it in the UI, or set it here only for local dev.

ARETE_PROTOCOL=wss:
# ARETE_HOST=
ARETE_PORT=443
# ARETE_USER=
# ARETE_PASS=

# If your control plane uses a self-signed cert chain, "1" allows insecure TLS for that
# connection only (process-wide NODE_TLS_REJECT_UNAUTHORIZED). Turn OFF for any
# host with a valid public certificate (e.g. dashboard.test.cns.dev).
ARETE_ALLOW_SELF_SIGNED=0

# The System name this app registers in the realm on connect (the SDK would
# otherwise use the machine hostname, e.g. "mac.lan").
# ARETE_SYSTEM_NAME=Arete Monitor
